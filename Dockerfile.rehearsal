FROM rust:1.99-bookworm AS rust-builder
WORKDIR /build/backend
COPY backend/Cargo.toml backend/Cargo.lock backend/rust-toolchain.toml ./
COPY backend/crates ./crates
RUN cargo build --locked --release -p zcanary-keeper-service -p zcanary-demo

FROM node:22-bookworm-slim
WORKDIR /workspace
COPY --from=rust-builder /build/backend/target/release/zcanary-keeper-service /usr/local/bin/zcanary-keeper-service
COPY --from=rust-builder /build/backend/target/release/zcanary-demo /usr/local/bin/zcanary-demo
COPY backend/scripts/delivery-relay.mjs backend/scripts/docker-rehearsal.mjs ./backend/scripts/
RUN mkdir -p /workspace/state /workspace/artifacts && chown -R node:node /workspace
USER node
